# Copy this file to ".env" and fill in values. ".env" is git-ignored.
# Everything here is OPTIONAL: tracking and splits work without any key.
# The Ask coach tab needs one of these. Video is never sent to a model.
# SwimVision tries OpenAI, then Gemini, then a local Ollama model.

OPENAI_API_KEY=
GEMINI_API_KEY=
# SWIMVISION_OPENAI_MODEL=gpt-4o-mini
# SWIMVISION_GEMINI_MODEL=gemini-3.5-flash
# SWIMVISION_OLLAMA_MODEL=qwen2.5:7b-instruct
